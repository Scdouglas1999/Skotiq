# =============================================================================
*.d
.melos_tool/
nightshade.db
.worktrees/

# HiPS framing verification scratch output (rendered PNGs for human inspection)
.hips_verify/

# Release build output
dist-linux/
dist-release/

# Local render-capture screenshots (dev verification, not goldens)
**/test/**/captures/

# Local landscape render-capture tooling (dev verification, not goldens)
**/captures_landscape_test.dart
**/imaging_landscape_capture_test.dart
**/test/screens/landscape_capture_util.dart
**/captures_fold_cover_test.dart

# Golden-test failure output (generated by `flutter test` on a mismatch)
**/test/**/failures/

# Flutter Rust Bridge ephemeral env (generated per machine)
