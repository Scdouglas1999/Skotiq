# Local one-off analysis / desktop automation scratch
/.narrative_hits.txt
/.codex-kwin-focus-nightshade.js

# Phase D — cellular push operator secrets (never committed). The FCM
# service-account JSON and the APNs .p8 auth key are referenced by path from
# push_config.json; keep all three out of git. The throwaway test-key
# fixtures under test/push/fixtures/ are explicitly re-included below.
push_config.json
*.p8
*service-account*.json
!**/test/push/fixtures/*.p8
!**/test/push/fixtures/*.pem

# Local release staging / packaging output (not source)
.release-draft/
dist-linux-v6-build/

# The scratch TMPDIR a wave-1 test run pointed at; never content.
.tmp-w1/

# Flutter writes these per machine (plugin symlinks into the local pub cache)
**/flutter/ephemeral/
