# release-pr-lists/04-defer-exclude.txt; oversized .DAT files violate GitHub's
# 100 MB hard limit. Files remain on disk for local research use.)
# =============================================================================
_fw_research/

# =============================================================================
# Internal release-engineering scratch (audit tool outputs, scratch scripts,
# stale build-output DLLs). Kept locally for the maintainer; not relevant for
# a downstream contributor building from source.
# =============================================================================

# Root-level audit tool outputs
.audit_highrisk*.txt
.audit_hits*.txt
.behavioral_audit_hits.txt
.ui_consistency_audit.txt
.all_unreg.txt
.unreg_files.txt
.unreg_files_clean.txt
.unreg_summary.txt

# Root-level scratch / one-off ad-hoc helpers
_old_marker.txt
_patch_caps.py
package-log.txt
goal.txt
# Stray, unreferenced root screenshot (use assets/ for documented images)
tppa_live_open.png

# Python bytecode generated by local audit tools
__pycache__/
*.py[cod]

# Internal UI-audit render captures (dev verification, not user-facing)
.ui-audit-screenshots/

# Internal report / audit / planning trees
/report/
/reports/
/docs/audits/
/docs/code-quality/
/docs/plans/
# Release-readiness evidence dumps stay local, but the CI gate INPUT files
# below must be tracked — every CI run reads them (see .github/workflows/
# ci.yml Analyze + Launch Gate jobs). The 2026-05-17 prune (3a25ef6e)
# ignored the whole directory and broke every CI run since: the gates'
# policy/baseline/register inputs vanished from checkouts. Use `*` (not a
# bare directory ignore) so the negations below can take effect.
/docs/production-readiness/*
!/docs/production-readiness/analyzer-policy.yaml
!/docs/production-readiness/critical-warning-codes.txt
!/docs/production-readiness/highrisk-baseline.txt
!/docs/production-readiness/behavioral-audit-register.md
!/docs/production-readiness/fail_closed_rules.yaml
/docs/science_mockups/
# Internal audit / planning / release-inventory docs (kept locally, not public)
/docs/backend-architecture-audit.md
/docs/driver-agnostic-audit.md
/docs/driver-agnostic-audit-followup.md
/docs/consolidation-implementation-plan.md
/docs/consolidation-workflow.md
/docs/releases/v2.6.0-inventory.md
/docs/frb_warnings_*.txt

# Build-output DLLs that get re-emitted by cargo + the packaging script.
# The single canonical libraw.dll the installer consumes lives at
# apps/desktop/windows/runner/Release/libraw.dll and is whitelisted below.
apps/desktop/*.dll
apps/desktop/windows/*.dll
apps/desktop/windows/runner/*.dll
apps/desktop/windows/runner/Debug/*.dll
apps/desktop/windows/runner/Release/*.dll
!apps/desktop/windows/runner/Release/libraw.dll

# Build-log scratch dir used by release packaging scripts
/build-logs/

# =============================================================================
# IDE and Editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# =============================================================================
# Dart/Flutter
# =============================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# Generated code markers (keep generated files, ignore markers)
*.g.dart.info
*.freezed.dart.info

# Flutter specific
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.*
**/ios/Flutter/.last_build_id
**/ios/.generated/
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/Runner/GeneratedPluginRegistrant.*

# =============================================================================
# Rust
# =============================================================================
**/target/

# Same path without the trailing slash, because `**/target/` matches only
# DIRECTORIES. Developers here point native/nightshade_native/target at a
# shared cargo cache with a symlink, which git sees as a file, not a directory
# — so the rule above let it through and a snapshot commit tracked a symlink
# holding one machine's absolute cache path. Every worktree made from that
# branch then materialised it as a plain text file (git's core.symlinks can be
# false) and `cargo build` died with "Not a directory (os error 20)".
/native/nightshade_native/target
**/*.rs.bk
Cargo.lock
!native/nightshade_native/Cargo.lock

# Negation: the Dart models/target/ directory holds source files (catalog
# target types), not Rust build output. Without this, **/target/ above swallows
# target_models.dart and the package fails to compile from a fresh clone.
!packages/nightshade_core/lib/src/models/target/
!packages/nightshade_core/lib/src/models/target/**

# But keep Cargo.lock for apps (not libraries) - uncomment if needed:
# !apps/**/Cargo.lock

# =============================================================================
# Native/Compiled Binaries
# =============================================================================
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries (at root and build folders)
/*.dll
/*.so
/*.dylib

# Compiled Static libraries
/*.lai
/*.la
/*.a
/*.lib

# BUT track lib/ directory for required dependencies (LibRaw, etc.)
!lib/
!lib/**

# Executables
*.exe
*.out
*.app

# Fortran module files
*.mod
*.smod

# =============================================================================
# Vendor SDKs (large binary dependencies)
# =============================================================================
SDKs/

# 17 MB JPL DE421 ephemeris kernel. No reader for it exists in any crate or
# package; sun and moon positions come from the analytic series in
# native/nightshade_native/sequencer/src/scheduling/ephemeris.rs.
/de421.bsp

# =============================================================================
# Logs and Temporary Files
# =============================================================================
logs/
*.log
*.tmp
*.temp
nul
build_output.txt
temp_*.txt

# =============================================================================
# Development/Debug Scripts (root level)
# =============================================================================
# Temporary PowerShell scripts. Anchored to the root: unanchored globs also
# hide supported tooling deeper in the tree (scripts/test_lan_push.ps1 and
# scripts/test_update_system.ps1 are documented in docs/OTA_UPDATE_TESTING.md).
/check_*.ps1
/find_*.ps1
/verify_*.ps1
/test_*.ps1

# Temporary fix scripts
/fix_*.sh
/fix_*.py

# Temporary Dart test scripts (root level only)
/test_*.dart
/inspect_*.dart

# =============================================================================
# Documentation (AI-generated implementation notes - not core docs)
# =============================================================================
# Keep these out of version control - they're development notes
*_IMPLEMENTATION.md
*_IMPLEMENTATION_SUMMARY.md
*_README.md
NOT_IMPLEMENTED_FIXES.md

# Keep docs/ tracked. CLAUDE.md stays UNTRACKED (internal AI/deploy notes incl.
# a LAN IP + SSH) — it's ignored at the top of this file; do NOT re-include it.
!docs/

