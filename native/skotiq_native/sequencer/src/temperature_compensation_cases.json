[
  {
    "name": "the first reading is the reference",
    "steps_per_degree": -12.0,
    "min_steps": 5,
    "ops": [
      {
        "op": "step",
        "temperature": 10.0,
        "position": 25000,
        "expect": {
          "kind": "take_reference",
          "moved_from": null
        }
      },
      {
        "op": "step",
        "temperature": 10.0,
        "position": 25000,
        "expect": {
          "kind": "hold"
        }
      }
    ]
  },
  {
    "name": "a correction under the smallest move waits and is not lost",
    "steps_per_degree": -12.0,
    "min_steps": 5,
    "ops": [
      {
        "op": "step",
        "temperature": 10.0,
        "position": 25000,
        "expect": {
          "kind": "take_reference",
          "moved_from": null
        }
      },
      {
        "op": "step",
        "temperature": 9.9,
        "position": 25000,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "step",
        "temperature": 9.7,
        "position": 25000,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "step",
        "temperature": 9.6,
        "position": 25000,
        "expect": {
          "kind": "move",
          "target": 25005,
          "owed": 5
        }
      },
      {
        "op": "moved_to",
        "target": 25005
      },
      {
        "op": "step",
        "temperature": 9.6,
        "position": 25005,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "step",
        "temperature": 9.0,
        "position": 25005,
        "expect": {
          "kind": "move",
          "target": 25012,
          "owed": 7
        }
      }
    ]
  },
  {
