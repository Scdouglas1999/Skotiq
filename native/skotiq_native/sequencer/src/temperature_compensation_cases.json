  {
    "name": "a filter offset keeps the correction owed",
    "steps_per_degree": -12.0,
    "min_steps": 5,
    "ops": [
      {
        "op": "step",
        "temperature": 10.0,
        "position": 25000,
        "expect": {
          "kind": "take_reference",
          "moved_from": null
        }
      },
      {
        "op": "step",
        "temperature": 9.7,
        "position": 25000,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "shifted_by",
        "steps": 30
      },
      {
        "op": "step",
        "temperature": 9.7,
        "position": 25030,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "step",
        "temperature": 9.6,
        "position": 25030,
        "expect": {
          "kind": "move",
          "target": 25035,
          "owed": 5
        }
      },
      {
        "op": "moved_to",
        "target": 25035
      },
      {
        "op": "shifted_by",
        "steps": -42
      },
      {
        "op": "step",
        "temperature": 9.6,
        "position": 24993,
        "expect": {
          "kind": "hold"
        }
      },
      {
        "op": "step",
        "temperature": 9.0,
        "position": 24993,
        "expect": {
          "kind": "move",
          "target": 25000,
          "owed": 7
        }
      }
    ]
  },
