{
  "version": 1,
  "purpose": "Golden .wcs headers, written the way the solvers write them, with the exact card split and parse the one .wcs parser produces; read by native/skotiq_native/platesolve/src/wcs_conformance_tests.rs.",
  "implementations": {
    "rust": "native/skotiq_native/platesolve/src/lib.rs (parse_wcs_file_inner over skotiq_imaging::header_from_text and SipWcs::from_header)"
  },
  "tolerances": {
    "verbatim_fields": "ra, dec, cd1_1..cd2_2 and every SIP coefficient are compared for EXACT equality: read straight out of the card, or for a CDELT/CROTA header the CD matrix SipWcs::from_header computes.",
    "derived_fields": "pixel_scale, rotation, field_width, field_height are computed, so they are compared to within 1e-9 absolute."
  },
  "cases": [
    {
      "id": "astap_card_stream",
      "why": "A real ASTAP .wcs is fixed-width 80-character cards packed end to end with NO line terminators. Splitting on newlines yields one enormous line, so only SIMPLE is inspected and CRVAL1 is invisible: the solve succeeds and the parse reports it missing. This is the C1 regression, on both sides at once.",
      "file": "cases/astap_card_stream.wcs",
      "cards": {
        "count": 20,
        "max_length": 80,
        "at": {
          "7": "CRVAL1  = 187.70000000000000 / RA of reference pixel [deg]                      ",
          "13": "CD1_1   = -4.1656784453730E-04                                                  ",
          "19": "END                                                                             "
        }
      },
      "rust": {
        "outcome": "ok",
        "ra": 187.7,
        "dec": -12.39,
        "cd1_1": -0.0004165678445373,
        "cd1_2": -9.0895427026955e-06,
        "cd2_1": -9.0895427026955e-06,
        "cd2_2": 0.0004165678445373,
        "pixel_scale": 1.500001199999984,
        "rotation": -1.2500000000000164,
        "field_width": 1.7266680479999816,
        "field_height": 1.1758342739999876,
        "a_order": 0,
        "b_order": 0,
        "ap_order": 0,
        "bp_order": 0,
        "a_coeffs": [],
        "b_coeffs": [],
        "ap_coeffs": [],
        "bp_coeffs": []
      }
    },
    {
      "id": "astap_crlf_delimited",
      "why": "The same header written one padded card per line with CRLF terminators. Must parse to byte-identical results as astap_card_stream: the card splitter honours newlines first and only splits segments longer than one card.",
      "file": "cases/astap_crlf_delimited.wcs",
      "cards": {
        "count": 20,
        "max_length": 80,
        "at": {
          "7": "CRVAL1  = 187.70000000000000 / RA of reference pixel [deg]                      ",
          "13": "CD1_1   = -4.1656784453730E-04                                                  ",
          "19": "END                                                                             "
        }
      },
      "rust": {
        "outcome": "ok",
        "ra": 187.7,
        "dec": -12.39,
        "cd1_1": -0.0004165678445373,
        "cd1_2": -9.0895427026955e-06,
        "cd2_1": -9.0895427026955e-06,
        "cd2_2": 0.0004165678445373,
        "pixel_scale": 1.500001199999984,
        "rotation": -1.2500000000000164,
        "field_width": 1.7266680479999816,
        "field_height": 1.1758342739999876,
        "a_order": 0,
        "b_order": 0,
        "ap_order": 0,
        "bp_order": 0,
        "a_coeffs": [],
        "b_coeffs": [],
        "ap_coeffs": [],
        "bp_coeffs": []
      }
    },
    {
      "id": "astrometry_net_sip",
      "why": "astrometry.net writes IMAGEW/IMAGEH instead of NAXIS1/2, a CD matrix with exact-zero off-diagonal terms (north-up, rotation 0), SIP distortion terms and the A_DMAX diagnostic sibling that must NOT be read as a polynomial term. No CDELT and no CROTA2 anywhere.",
      "file": "cases/astrometry_net_sip.wcs",
      "cards": {
        "count": 26,
        "max_length": 61,
        "at": {
          "5": "CRVAL1  = 150.00000000000000",
          "13": "A_ORDER =                    2",
          "25": "END"
        }
      },
      "rust": {
        "outcome": "ok",
        "ra": 150.0,
        "dec": 20.0,
        "cd1_1": -0.0002777778,
        "cd1_2": 0.0,
        "cd2_1": 0.0,
        "cd2_2": 0.0002777778,
        "pixel_scale": 1.00000008,
        "rotation": 0.0,
        "field_width": 0.27777779999999996,
        "field_height": 0.22222224,
        "a_order": 2,
        "b_order": 2,
        "ap_order": 1,
        "bp_order": 1,
        "a_coeffs": [
          0.0,
          0.0,
          1.1e-06,
          0.0,
          -2.2e-06,
          0.0,
          3.3e-06,
          0.0,
          0.0
        ],
        "b_coeffs": [
          0.0,
          0.0,
          4.4e-06,
          0.0,
          0.0,
          0.0,
          -5.5e-06,
          0.0,
          0.0
        ],
        "ap_coeffs": [
          0.0,
          0.0,
          6.6e-06,
          0.0
        ],
        "bp_coeffs": [
          0.0,
          -7.7e-06,
          0.0,
          0.0
        ]
      }
    },
    {
      "id": "cdelt_only_no_cd_matrix",
      "why": "A solved header that carries CDELT/CROTA but no CD matrix. It is read as wcslib reads it, the CD matrix being CDELT rotated by CROTA2, exactly as the same cards in a frame's header are.",
      "file": "cases/cdelt_only_no_cd_matrix.wcs",
      "cards": {
        "count": 9,
        "max_length": 80,
        "at": {
          "3": "CRVAL1  = 187.70000000000000 / RA of reference pixel [deg]                      ",
          "8": "END                                                                             "
        }
      },
      "rust": {
        "outcome": "ok",
        "ra": 187.7,
        "dec": -12.39,
        "cd1_1": -0.0004165678445373045,
        "cd1_2": -9.089542702695478e-06,
        "cd2_1": -9.089542702695478e-06,
        "cd2_2": 0.0004165678445373045,
        "pixel_scale": 1.5000012000000003,
        "rotation": -1.2499999999999998,
        "field_width": 1.7266680480000003,
        "field_height": 1.175834274,
        "a_order": 0,
        "b_order": 0,
        "ap_order": 0,
        "bp_order": 0,
        "a_coeffs": [],
        "b_coeffs": [],
        "ap_coeffs": [],
        "bp_coeffs": []
      }
    },
    {
      "id": "misaligned_equals_column",
      "why": "Cards whose '=' sits at column 7 instead of the FITS-mandated column 8 (keyword not padded to 8). The keyword field then holds '=' and the text is refused as a FITS header, as a frame file with such a card is.",
      "file": "cases/misaligned_equals_column.wcs",
      "cards": {
        "count": 8,
        "max_length": 58,
        "at": {
          "0": "CRVAL1 = 187.70000000000000 / RA of reference pixel [deg]",
          "7": "CD2_2 = 4.1656784453730E-004"
        }
      },
      "rust": {
        "outcome": "not_a_header"
      }
    },
    {
      "id": "malformed_crval1",
      "why": "A malformed CRVAL1 must never become a 'successful' solve at RA 0. Both parsers must fail closed; they report the failure differently.",
      "file": "cases/malformed_crval1.wcs",
      "cards": {
        "count": 6,
        "max_length": 80,
        "at": {
          "0": "CRVAL1  = not-a-number / deliberately malformed                                 "
        }
      },
      "rust": {
        "outcome": "parse_error",
        "keyword": "CRVAL1",
        "raw_value": "not-a-number"
      }
    },
    {
      "id": "missing_crval2",
      "why": "Half a position is not a position. Missing CRVAL2 must fail on both sides rather than yielding Dec 0.",
      "file": "cases/missing_crval2.wcs",
      "cards": {
        "count": 5,
        "max_length": 80,
        "at": {
          "0": "CRVAL1  = 187.70000000000000                                                    "
        }
      },
      "rust": {
        "outcome": "missing_keyword",
        "keyword": "CRVAL2"
      }
    },
    {
      "id": "no_wcs_keywords",
      "why": "A sidecar with no WCS keywords at all \u2014 the shape a failed solve leaves behind.",
      "file": "cases/no_wcs_keywords.wcs",
      "cards": {
        "count": 3,
        "max_length": 51,
        "at": {
          "0": "COMMENT no coordinates here"
        }
      },
      "rust": {
        "outcome": "missing_keyword",
        "keyword": "CRVAL1"
      }
    },
    {
      "id": "nan_crval1",
      "why": "Edge case the fixture exists to document rather than to bless: the literal 'NaN' is accepted by Rust f64::from_str AND by Dart double.tryParse, so a WCS carrying it produces a solve both parsers report as SUCCESSFUL with a NaN position. Pinned as current behaviour on both sides; see README 'Known hazards'.",
      "file": "cases/nan_crval1.wcs",
      "cards": {
        "count": 8,
        "max_length": 80,
        "at": {
          "0": "CRVAL1  = NaN / hazard: parses as a float in BOTH languages                     "
        }
      },
      "rust": {
        "outcome": "ok",
        "ra": "nan",
        "dec": -12.39,
        "cd1_1": -0.0004165678445373,
        "cd1_2": -9.0895427026955e-06,
        "cd2_1": -9.0895427026955e-06,
        "cd2_2": 0.0004165678445373,
        "pixel_scale": 1.500001199999984,
        "rotation": -1.2500000000000164,
        "field_width": 1.7266680479999816,
        "field_height": 1.1758342739999876,
        "a_order": 0,
        "b_order": 0,
        "ap_order": 0,
        "bp_order": 0,
        "a_coeffs": [],
