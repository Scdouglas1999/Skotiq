# Skotiq headless appliance configuration.
# Installed to /etc/skotiq/headless.env (mode 0640 root:skotiq).
# Every variable here is read by apps/desktop/lib/main_headless.dart.

# --- Authentication (REQUIRED for LAN exposure) ------------------------------
# Without any token the server binds to 127.0.0.1 only. install.sh generates
# a random token here on first install.
SKOTIQ_AUTH_TOKEN=change-me-to-a-long-random-token

# Optional scoped tokens: read-only monitoring / imaging-control-only.
#SKOTIQ_VIEW_TOKEN=
#SKOTIQ_CONTROL_TOKEN=

# --- Network -----------------------------------------------------------------
SKOTIQ_PORT=8080

# Print successful pairing codes to the journal (journalctl -u
# skotiq-headless). Recommended on a true headless box — it is the only
# way for the operator to read a pairing code.
SKOTIQ_PAIRING_PRINT_CODES=true

# Comma-separated CORS allow-list for cross-origin web dashboards.
#SKOTIQ_CORS_ORIGINS=https://dash.example.org

# --- TLS ----------------------------------------------------------------------
# Self-signed cert is generated under $HOME app-support on first start when
# enabled; the SPKI SHA-256 fingerprint is printed to the journal and is what
# the mobile app pins at pairing time.
#SKOTIQ_TLS=true
# Or bring your own PEM pair (setting either implies TLS):
#SKOTIQ_TLS_CERT=/etc/skotiq/server.crt
#SKOTIQ_TLS_KEY=/etc/skotiq/server.key

# --- Storage -------------------------------------------------------------------
# Native persistence root (defect maps etc.). The systemd unit already pins
# this; only override if you relocate state.
#SKOTIQ_DATA_DIR=/var/lib/skotiq/data

# Drift database directory. The systemd unit pins this outside any user
# Documents folder for daemon/appliance installs.
#SKOTIQ_DATABASE_DIR=/var/lib/skotiq/database

# Extra remote directory browse roots for Android/tablet/browser clients.
# Format: Label=/path;Another Label=/other/path
# For external capture disks, also add the path to ReadWritePaths in the
# systemd unit or a drop-in when ProtectSystem=strict is enabled.
#SKOTIQ_BROWSE_ROOTS=Captures=/mnt/captures

# --- OTA updates ----------------------------------------------------------------
# When unset, /api/system/update/* is disabled (phones cannot trigger OTA).
#SKOTIQ_UPDATE_SERVER=https://updates.example.org
#SKOTIQ_UPDATE_CHANNEL=stable

# --- Cellular push ---------------------------------------------------------------
# Path to push_config.json (FCM service-account / APNs .p8 references).
# See docs/release/cellular-push-setup.md. Default location when unset:
# $HOME/.local/share/<app-support>/Skotiq/push_config.json
#SKOTIQ_PUSH_CONFIG=/etc/skotiq/push_config.json

# --- Danger zone -------------------------------------------------------------------
# Unauthenticated LAN control. NEVER on a network you do not fully control.
#SKOTIQ_ALLOW_UNAUTHENTICATED_LAN=true
