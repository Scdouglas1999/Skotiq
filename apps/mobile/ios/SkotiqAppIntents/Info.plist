<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Skotiq Voice</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  Modern AppIntents extensions do not use the legacy NSExtension entry
	  point. The AppIntents framework auto-discovers any concrete
	  `AppIntent` types in the linked binary; we still ship an Info.plist
	  so the extension target builds with the usual Xcode plumbing.

	  CRITICAL: the App Group entitlement
	  `group.com.skotiq.app` MUST be enabled on this extension target
	  AND the main Runner target in Xcode. Without it, the
	  UserDefaults(suiteName:) call in SkotiqAppIntents.swift returns
	  nil and every intent fails loudly (per repo policy).
	-->
</dict>
</plist>
