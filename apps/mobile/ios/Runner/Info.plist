<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Skotiq Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>skotiq_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Local Network Access Permission -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Skotiq needs access to your local network to discover and connect to your astrophotography equipment server.</string>
	<!-- Bonjour Services for mDNS Discovery -->
	<key>NSBonjourServices</key>
	<array>
		<string>_skotiq._tcp</string>
	</array>
	<!-- Camera Permission (for QR code scanning) -->
	<key>NSCameraUsageDescription</key>
	<string>Skotiq needs access to your camera to scan QR codes for quick server connection.</string>
	<!-- Photo Library Permission (for saving captured images) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Skotiq needs permission to save captured astrophotography images to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Skotiq needs permission to access your photo library to view and manage captured images.</string>
	<!-- Location Permission (for astronomical calculations) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Skotiq needs your location to accurately calculate celestial positions and optimize your astrophotography session.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Skotiq needs your location to accurately calculate celestial positions and optimize your astrophotography session.</string>
	<!-- Live Activities (iOS 16.2+). Pins a rich, dynamic UI to the
	     lock screen and Dynamic Island for the duration of an imaging
	     sequence so the operator gets at-a-glance progress without
	     unlocking the phone. NSSupportsLiveActivitiesFrequentUpdates
	     opts in to the higher-frequency budget so per-frame ticks during
	     long exposures can be reflected promptly. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!-- Phase E: background execution modes.
	     * remote-notification — lets APNs wake the app in the background so a
	       Phase D critical alert (weather unsafe, mount runaway, guiding lost,
	       equipment disconnect) is processed even while the phone is asleep and
	       out of LAN-UDP push range. Pairs with the `aps-environment`
	       entitlement and the APNs registration in AppDelegate.swift /
	       push_registration_service.dart.
	     * fetch — opportunistic background refresh so the companion can pull the
	       latest sequence/weather snapshot when iOS grants a background window,
	       keeping the Live Activity / watch complication from going stale during
	       a long overnight run.
	     NOTE: the LAN UDP push receiver (lan_push_notification_receiver.dart) is
	     pure dart:io and is suspended by iOS in the background regardless of
	     these modes — APNs is the OS-sanctioned wake path, which is why
	     remote-notification is declared here. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
