<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Critical Alerts entitlement.

	  Required so notifications with InterruptionLevel.critical (see
	  apps/mobile/lib/services/notification_service.dart — notifySafety,
	  notifyMountParked, notifyGuidingLost, notifyEquipmentDisconnected) can
	  bypass Do Not Disturb, Focus modes and the ringer/silent switch and
	  wake an operator who is asleep while a sequence runs unattended.

	  This key alone is NOT enough — Apple must explicitly grant the
	  entitlement on the developer account (see
	  apps/mobile/ios/CRITICAL_ALERTS_SETUP.md). Until then, the build will
	  still succeed but iOS silently downgrades the alerts to default
	  interruption level.
	-->
	<key>com.apple.developer.usernotifications.critical-alerts</key>
	<true/>
	<!--
	  APNs environment. Enables remote (push) notifications so the Phase D
	  desktop server can deliver a critical alert over cellular/APNs when the
	  phone is asleep and out of LAN-UDP range (see
	  apps/mobile/lib/services/push_registration_service.dart and the server's
	  POST /api/push/register-token, platform=apns).

	  This file ships `development` and is the entitlements file for the Debug
	  and Profile build configurations only.

	  IMPORTANT — iOS does NOT auto-rewrite `development` -> `production`. The
	  embedded entitlement is taken VERBATIM from whichever entitlements file
	  CODE_SIGN_ENTITLEMENTS points at for the active build configuration; it is
	  NOT derived from the provisioning profile. So a Release archive that signs
	  against THIS file would ship a sandbox-only APNs token and every cellular
	  safety push would be rejected (BadDeviceToken) by the production APNs host.

	  The real per-configuration handling: the Release build configuration points
	  CODE_SIGN_ENTITLEMENTS at Runner/RunnerRelease.entitlements (which sets
	  `aps-environment=production`); Debug/Profile keep THIS file. Do NOT
	  hard-code `production` here — that would break development device installs
	  (a dev build needs a sandbox token). See docs/ios-release-setup.md §APNs.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  App Group. Shared UserDefaults container used by:
	    * AppDelegate.swift watch-complication snapshot publisher
	      (UserDefaults(suiteName: "group.com.skotiq.app")), and
	    * the SkotiqAppIntents / voice-control snapshot.
	  AppDelegate.swift fails loudly with `app_group_unavailable` if this
	  entitlement is absent, so it must be present on the Runner target AND on
	  every extension target that reads the suite. The App Group itself must be
	  created in the Apple Developer portal and enabled on the App ID — see
	  docs/ios-release-setup.md and SkotiqWatchComplication/SETUP.md.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.skotiq.app</string>
	</array>
</dict>
</plist>
